# ── COPY THIS FILE TO .env AND FILL IN ALL VALUES ──────────────────────────
# Never commit .env to git.

# ── App ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=production          # production | development
SECRET_KEY=CHANGE_ME_run_openssl_rand_hex_32
LOG_LEVEL=warning               # debug | info | warning | error

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://mohideen:CHANGE_ME@db:5432/mohideen_db
# For docker-compose the host is "db"; for local dev use "localhost"

# ── PostgreSQL (used by docker-compose to initialise the db service) ─────────
POSTGRES_DB=mohideen_db
POSTGRES_USER=mohideen
POSTGRES_PASSWORD=CHANGE_ME

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
REDIS_PASSWORD=CHANGE_ME

# ── Cookies / CORS ────────────────────────────────────────────────────────────
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=https://your-admin-domain.com,https://www.your-admin-domain.com

# ── Session Duration ─────────────────────────────────────────────────────────
MOBILE_SESSION_DAYS=40          # JWT sliding session for mobile app users
ADMIN_SESSION_DAYS=10           # JWT sliding session for admin dashboard

# ── Scheduler ────────────────────────────────────────────────────────────────
CHANDA_REMINDER_HOUR=9          # Hour (24h, IST) to send chanda FCM reminders

# ── Firebase ─────────────────────────────────────────────────────────────────
# Path to the service account JSON file (relative to backend/)
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# ── Cloudinary (future — leave empty to use local storage) ───────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Gunicorn ─────────────────────────────────────────────────────────────────
GUNICORN_WORKERS=2
