# ── COPY THIS FILE TO .env AND FILL IN ALL VALUES ──────────────────────────
# Never commit .env to git.

# ── App ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=production          # production | development
SECRET_KEY=CHANGE_ME_run_openssl_rand_hex_32
LOG_LEVEL=warning               # debug | info | warning | error
LOG_DIR=/app/logs               # directory for rotated log files; must exist/be writable

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://mohideen:CHANGE_ME@db:5432/mohideen_db
# For docker-compose the host is "db"; for local dev use "localhost"

# ── PostgreSQL (used by docker-compose to initialise the db service) ─────────
POSTGRES_DB=mohideen_db
POSTGRES_USER=mohideen
POSTGRES_PASSWORD=CHANGE_ME

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
REDIS_PASSWORD=CHANGE_ME
# Optional — rate limiting fails open (skips limiting, logs a warning) if
# Redis is unreachable, so the app still runs without it.

# ── Cookies / CORS ────────────────────────────────────────────────────────────
COOKIE_SECURE=true              # must be false for local http:// dev
COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=https://your-admin-domain.com,https://www.your-admin-domain.com

# ── Session Duration ─────────────────────────────────────────────────────────
MOBILE_SESSION_DAYS=40          # JWT sliding session for mobile app users
ADMIN_SESSION_DAYS=10           # JWT sliding session for admin dashboard

# ── Scheduler ────────────────────────────────────────────────────────────────
CHANDA_REMINDER_HOUR=9          # Hour (24h, IST) to send chanda FCM reminders

# ── OTP (only relevant once a route actually calls get_otp_service() —
#    app/services/otp/ exists but is not currently wired to any endpoint) ─────
OTP_PROVIDER=console            # console (logs OTP, no real SMS) | msg91
# Required only when OTP_PROVIDER=msg91:
MSG91_AUTH_KEY=CHANGE_ME
MSG91_TEMPLATE_ID=CHANGE_ME
MSG91_SENDER_ID=MOHDIN
MSG91_COUNTRY_CODE=91
MSG91_OTP_EXPIRY=5

# ── Firebase ─────────────────────────────────────────────────────────────────
# NOTE: not currently read by app/utils/fcm.py — it hardcodes the path to
# backend/serviceAccountKey.json regardless of this value. Kept for
# documentation; the real requirement is that the file exists at that path
# (gitignored — provision it separately per environment).
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# ── Cloudinary (optional — leave empty to use local storage) ───────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Gunicorn ─────────────────────────────────────────────────────────────────
GUNICORN_WORKERS=2
GUNICORN_LOG_DIR=               # empty = log to stdout/stderr (Render-safe default); set a path to use file-based logs (e.g. the docker-compose VPS setup)
