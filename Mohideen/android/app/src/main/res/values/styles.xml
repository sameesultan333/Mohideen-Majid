<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme.
         Light, not DayNight. Every screen in this app is designed light
         (ivory / white / emerald) and there is no dark variant. Declaring
         DayNight meant that on a phone in dark mode Android applied dark
         defaults to everything it owns — the status bar, native dialogs, text
         inputs — while the JS UI stayed light, which is what made the status
         bar icons nearly unreadable. Light keeps the system chrome in step
         with the UI we actually draw. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>

        <!-- Never let Android auto-invert this app in dark mode. Force-dark
             recolours surfaces it thinks are light, which flipped the ivory
             status-bar strip to a dark one while the icons stayed dark —
             dark-on-dark, effectively invisible. -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <!-- Launch-time system bar appearance only.
             Once JS is up, src/theme/statusBar.js owns both the strip colour and
             the icon style: a screen declares the colour at its top edge and the
             icon style is derived from that colour's luminance, so the bar always
             matches the screen beneath it and the clock/battery/signal always
             have contrast. These two values just cover the first frame and are
             set to the emerald default nearly every screen opens with — light
             icons on a dark bar. Keep them in step with DEFAULT_TOP_COLOR.

             android:statusBarColor is honoured up to API 34; from API 35
             edge-to-edge is enforced and the system ignores it, which is fine —
             the SafeAreaView in App.jsx paints the same colour behind the bar on
             those versions, so the strip looks identical either way. -->
        <item name="android:statusBarColor">@color/status_bar_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

</resources>
