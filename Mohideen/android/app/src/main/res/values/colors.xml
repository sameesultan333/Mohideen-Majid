<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Adaptive icon background — matches the app's primary green -->
    <color name="ic_launcher_background">#1B5E20</color>

    <!-- Launch-time status bar colour. JS takes over once loaded (see
         src/theme/statusBar.js); this only covers the first frame, so it must
         match DEFAULT_TOP_COLOR — the emerald header nearly every screen opens
         with — or the bar flashes a different colour on cold start. -->
    <color name="status_bar_bg">#053B26</color>

    <!-- Notification accent color (setColor). The status-bar icon itself is
         forced monochrome white by Android, but this tints the small icon and
         app-name in the pulled-down notification shade. Gold (#D4AF37) matches
         the app's green+gold theme and keeps good contrast on both light and
         dark notification backgrounds (dark green would vanish in dark mode). -->
    <color name="notification_color">#D4AF37</color>
</resources>
